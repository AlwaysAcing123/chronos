# Development-only PostgreSQL settings used by compose.yaml and integration tests.
CHRONOS_POSTGRES_PORT=55432
CHRONOS_TEST_POSTGRES_URL=postgresql://chronos:chronos_local@127.0.0.1:55432/chronos
# Database used by chronos_paper_trading_server.
CHRONOS_POSTGRES_URL=postgresql://chronos:chronos_local@127.0.0.1:55432/chronos
# Alpaca market-data credentials, read only by chronos_paper_trading_server
# --alpaca-iex. Set them in your shell or load them from a secret store at
# launch; never put values in this file, a .env file, or a command line.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
